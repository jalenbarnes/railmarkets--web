generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TierCode {
  FREE
  BASE
  MID
  TOP
}

enum BillingState {
  ACTIVE
  GRACE
  PAST_DUE
  CANCELED
  EXPIRED
  INCOMPLETE
}

enum InstrumentType {
  US_EQUITY
  ETF
  OPTION
  FOREX
  CRYPTO
}

enum ExecutionStatus {
  READY_NOW
  MONITOR
  READY_ON_PULLBACK
  CLOSED
  INVALIDATED
}

enum Direction {
  LONG
  SHORT
}

model User {
  id                String              @id @default(cuid())
  clerkUserId       String              @unique
  email             String?             @unique
  firstName         String?
  lastName          String?
  timezone          String?             @default("America/Chicago")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  entitlements      UserEntitlement[]
  watchlistItems    WatchlistItem[]
  freeCardViews     FreeCardDailyView[]
}

model TradeCard {
  id                  String             @id @default(cuid())
  ticker              String
  companyName         String
  instrumentType      InstrumentType
  sessionTag          String?
  direction           Direction
  executionStatus     ExecutionStatus
  confidence          Int?
  thesisPreview       String?
  tradePlan           String?
  plannedEntryTrigger String?
  plannedEntryPrice   Decimal?           @db.Decimal(12, 4)
  plannedStopPrice    Decimal?           @db.Decimal(12, 4)
  plannedTarget1      Decimal?           @db.Decimal(12, 4)
  plannedTarget2      Decimal?           @db.Decimal(12, 4)
  sourceLabel         String?
  sourceUrl           String?
  publishedAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  watchlistItems      WatchlistItem[]
  freeCardViews       FreeCardDailyView[]

  @@index([ticker])
  @@index([executionStatus])
  @@index([publishedAt])
}

model UserEntitlement {
  id             String       @id @default(cuid())
  userId         String
  tierCode       TierCode     @default(FREE)
  billingState   BillingState @default(INCOMPLETE)
  stripeCustomerId String?
  stripeSubscriptionId String?
  currentPeriodEnd DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tierCode, billingState])
}

model WatchlistItem {
  id          String    @id @default(cuid())
  userId      String
  tradeCardId String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradeCard   TradeCard @relation(fields: [tradeCardId], references: [id], onDelete: Cascade)

  @@unique([userId, tradeCardId])
  @@index([userId])
  @@index([tradeCardId])
}

model FreeCardDailyView {
  id         String    @id @default(cuid())
  userId     String
  tradeCardId String
  localDate  DateTime
  timezone   String
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradeCard  TradeCard @relation(fields: [tradeCardId], references: [id], onDelete: Cascade)

  @@unique([userId, tradeCardId, localDate])
  @@index([userId, localDate])
}
